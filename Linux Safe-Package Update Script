#!/bin/bash

# ==============================================================================
# TOPOLOGY & CONFIGURATION PLACEHOLDERS (FILL ME IN WHEN MAP DROPS)
# ==============================================================================
TARGET_SERVER_IP="[PUT_SERVER_IP_HERE]"          # e.g., "10.1.1.10"
SCORING_ENGINE_IP="[PUT_SCORING_ENGINE_IP_HERE]" # e.g., "10.1.1.50"

# Define specific critical service packages that require targeted patching 
# (Avoids breaking the OS or dependencies with a blind full-system upgrade)
SCORED_SERVICES=(
    "[PUT_SERVICE_PACKAGE_1_HERE]" # e.g., apache2, nginx, mysql-server
    "[PUT_SERVICE_PACKAGE_2_HERE]" # e.g., bind9, openssh-server
)
# ==============================================================================

# Ensure script is run as root
if [ "$EUID" -ne 0 ]; then
  echo "[-] Please run as root."
  exit 1
fi

echo "[+] Starting targeted package update sequence on server: $TARGET_SERVER_IP"

# 1. Refresh package repositories safely
echo "[+] Refreshing local package repositories..."
apt-get update -y 2>/dev/null || yum makecache -y 2>/dev/null || dnf makecache -y 2>/dev/null

# 2. Apply high-priority security patches to the base OS automatically
echo "[+] Applying core security-only patches..."
if command -v apt-get &> /dev/null; then
    apt-get --only-upgrade install -y $(apt-get -s upgrade | grep "^Inst" | grep -i security | awk '{print $2}') 2>/dev/null
elif command -v yum &> /dev/null; then
    yum update --security -y 2>/dev/null
elif command -v dnf &> /dev/null; then
    dnf update --security -y 2>/dev/null
fi

# 3. Iteratively patch specified scored packages if defined in placeholders
for pkg in "${SCORED_SERVICES[@]}"; do
    if [ "$pkg" != "[PUT_SERVICE_PACKAGE_1_HERE]" ] && [ -n "$pkg" ]; then
        echo "[+] Safely updating designated package: $pkg"
        if command -v apt-get &> /dev/null; then
            apt-get install --only-upgrade -y "$pkg"
        elif command -v yum &> /dev/null; then
            yum update -y "$pkg"
        elif command -v dnf &> /dev/null; then
            dnf update -y "$pkg"
        fi
    fi
done

echo "[+] Package update cycle completed for $TARGET_SERVER_IP."
echo "[*] REMINDER: Check the Quotient dashboard immediately to verify service status!"
